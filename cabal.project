packages: .

write-ghc-environment-files: always

source-repository-package
  type: git
  location: https://github.com/poscat0x04/shake-fpga
  tag: e7d5f4ad381fcc5d982a0c3e09c302851d1fde5c

package shake-fpga-test
  ghc-options: -Wall
               -Wincomplete-uni-patterns
               -Wincomplete-record-updates
               -Wunused-packages
  documentation: True
  haddock-html: True
  haddock-hoogle: True
  haddock-internal: True
  test-show-details: streaming
